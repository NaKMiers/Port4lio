MAIL_TO=


# =============================================================================
# MBTI
# =============================================================================
MBTI_RESULT_PRICE=


# =============================================================================
# IQ test
# =============================================================================
IQ_RESULT_PRICE=


# =============================================================================
# Effort waiver (MBTI + IQ)
# =============================================================================
# Rushed IQ attempts and straight-lined MBTI attempts get their result free, because a
# score reached by mashing measures nothing and we do not charge for a number we cannot
# stand behind. Set to false to drop that and paywall every attempt - which also removes
# the matching promise from /iq/method, so the published rule never outlives the code.
# Unset means on. Accepts true/1/on/yes and false/0/off/no.
EFFORT_WAIVER=


# =============================================================================
# PayOS
# =============================================================================
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=


# ============================================================================
# LLM - blog generation
# ============================================================================
# Powers "Generate blog" on /admin/blog. Server-only: it is read in
# `src/lib/blog/llm.ts`, which is marked `server-only` so the bearer token can
# never reach a browser bundle.
#
# The endpoint is OpenAI-shaped but it STREAMS BY DEFAULT - a request without
# `"stream": false` comes back as text/event-stream and `res.json()` fails on
# `data: `. The client always sets the flag; see the header in llm.ts.
#
# LLM_BASE_URL is optional and defaults to the host below. Set it to point at a
# different router without touching code.
LLM_API_KEY=
LLM_BASE_URL=


# ============================================================================
# Gemini - the fallback when the router cannot be reached
# ============================================================================
# Optional. With GOOGLE_API_KEY set, a generation that fails because the LLM
# router was UNREACHABLE - transport error, timeout, 401 on our key, 429, or a
# 5xx - is retried against Google's Generative Language API instead of failing.
#
# It does NOT engage when the router answered and the answer was unusable
# (empty reply, malformed JSON, a streamed body). That is a model behaving
# badly rather than a provider being down, and a second provider billed
# separately usually behaves badly too.
#
# The key is sent as an `x-goog-api-key` HEADER, never as `?key=` in the URL -
# a secret in a query string is written to every proxy log between here and
# Google. See the header in `src/lib/blog/llm.ts`.
#
# When the fallback runs, the generation response reports the model that
# actually wrote the post and the editor shows a warning saying so.
GOOGLE_API_KEY=
# Optional. Defaults to gemini-3.8-flash. Set it if that model stops being
# served to your key - a fallback that 404s only shows up on the day the
# primary is already down.
GEMINI_MODEL=
# Optional. Defaults to https://generativelanguage.googleapis.com/v1beta
GOOGLE_API_BASE_URL=


# ============================================================================
# The daily blog cron
# ============================================================================
# Required by POST/GET /api/cron/blog, which writes one post a day, draws its
# images and publishes it if it came out whole. WITHOUT this variable the route
# refuses every caller with a 404 - it never runs open, because an unset secret
# on a fresh deployment would otherwise leave a public endpoint that writes to
# the database and publishes to the live site.
#
# Any long random string. `openssl rand -hex 32` is fine. It is compared with
# `timingSafeEqual`, so a near-miss leaks nothing about how near it was.
#
# Send it as `Authorization: Bearer <secret>`, which is the shape Vercel Cron
# uses for CRON_SECRET - so a Vercel-scheduled run authenticates with no extra
# configuration. See `vercel.json`, or `docs/blog/generate-daily.yml` for the
# GitHub Actions version.
#
# The cron draws images, so it needs GOOGLE_API_KEY above as well. Without it
# every post lands archived with its prompts written and no pictures, which is
# the same outcome as an image provider having a bad morning.
CRON_SECRET=
